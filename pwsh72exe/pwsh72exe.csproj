<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pwsh72exe</RootNamespace>
    <AssemblyName>pwsh72exe.Gui</AssemblyName>
    <ApplicationIcon>..\.res\icon\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\.res\icon\icon.png" Link="Resources\icon.png" />
    <Content Include="..\.version\version" Link="Version" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\pwsh72exe.Core\pwsh72exe.Core.csproj" />
  </ItemGroup>

</Project>
